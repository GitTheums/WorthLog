# Git / VCS
.git
.gitignore
.gitattributes

# Dependencies (reinstalled in image)
node_modules
**/node_modules

# Build artifacts (rebuilt in image)
**/dist
**/coverage
*.tsbuildinfo

# Environment and secrets
.env
.env.*
!.env.example

# Local persistent data (bind-mounted at runtime — never bake into the image)
data
**/data
*.db
*.db-journal
*.db-shm
*.db-wal
*.backup.*
worthlog.backup.*

# Screenshots may contain private portfolio values
docs/screenshots

# Editor / OS / tooling
.cursor
.idea
.vscode
.DS_Store
Thumbs.db
agent-transcripts
tmp-*
*.log
npm-debug.log*
logs

# Tests and docs not needed for the image build
**/*.test.ts
**/*.test.tsx
**/src/test
**/src/tests
*.md
!README.md

# Docker compose override noise
docker-compose.override.yml

# Lint/test configs not copied into the image (keep context small)
eslint.config.*
**/vitest.config.*
.github
