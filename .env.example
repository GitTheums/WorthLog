# Server (local development defaults)
PORT=3001
NODE_ENV=development

# Directory for persistent data (SQLite database is stored at ${DATA_DIR}/worthlog.db)
DATA_DIR=./data

# Optional path to the built React app for production (Docker sets this automatically)
# CLIENT_DIST_DIR=./client/dist

# Reverse proxy trust (default: disabled — safe for direct LAN access on :8787).
# Set to the number of trusted proxy hops when WorthLog sits behind a reverse proxy
# that sets X-Forwarded-For (for example TRUST_PROXY=1).
# Do not set this to true/unconditional trust of arbitrary forwarded headers.
# TRUST_PROXY=1

# -----------------------------------------------------------------------------
# Docker Compose (see docker-compose.yml)
# -----------------------------------------------------------------------------
# Host: http://localhost:8787  →  container port 3000
# Container env:
#   NODE_ENV=production
#   PORT=3000
#   DATA_DIR=/app/data
#   TZ=Europe/Amsterdam
#
# Own the host data directory as UID 1000 so the container `node` user can write:
#   mkdir -p data
#   sudo chown -R 1000:1000 data
